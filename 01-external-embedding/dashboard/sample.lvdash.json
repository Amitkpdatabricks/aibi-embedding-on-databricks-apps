{
  "datasets": [
    {
      "name": "sales",
      "displayName": "Sales (samples.tpch)",
      "queryLines": [
        "SELECT o.o_orderkey AS order_key, o.o_orderdate AS order_date, o.o_orderstatus AS order_status,\n       o.o_totalprice AS revenue, c.c_custkey AS customer_key, n.n_name AS nation, r.r_name AS region\nFROM samples.tpch.orders o\nJOIN samples.tpch.customer c ON o.o_custkey = c.c_custkey\nJOIN samples.tpch.nation n ON c.c_nationkey = n.n_nationkey\nJOIN samples.tpch.region r ON n.n_regionkey = r.r_regionkey"
      ]
    }
  ],
